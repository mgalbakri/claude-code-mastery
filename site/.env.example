# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=your-api-key
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMON_SQUEEZY_STORE_ID=your-store-id
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=your-variant-id

# Resend — https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_AUDIENCE_ID=your-audience-id
EMAIL_FROM=Agent Code Academy <hello@agentcodeacademy.com>

# Site URL (used for OG images, canonical URLs)
NEXT_PUBLIC_BASE_URL=https://agentcodeacademy.com

# Testing only — set by CI, not needed locally
# DEPLOYMENT_URL=https://agentcodeacademy.com
# VERCEL_AUTOMATION_BYPASS_SECRET=your-bypass-secret
